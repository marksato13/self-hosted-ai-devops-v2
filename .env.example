# Copiar a .env, completar y proteger con: chmod 600 .env
# Nunca guardar valores reales en Git.

TZ=America/Lima

# Imagen oficial de Agent Canvas. En producción reemplazar latest por una versión probada.
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas:latest
OPENHANDS_PORT=8000
OPENHANDS_DATA_DIR=/home/CAMBIAR/.openhands
PROJECTS_DIR=/home/CAMBIAR/projects
# Generar con: openssl rand -hex 32
LOCAL_BACKEND_API_KEY=
OH_SECRET_KEY=

# OmniRoute
OMNIROUTE_PORT=20128
# Generar cada valor con: openssl rand -hex 32
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_STORAGE_ENCRYPTION_KEY=
OMNIROUTE_INITIAL_PASSWORD=
# Se crea desde el panel de OmniRoute después del primer arranque.
OMNIROUTE_API_KEY=

# Límites operativos de la plataforma. Los límites reales también deben
# configurarse en cada proveedor remoto.
MAX_CONCURRENT_TASKS=1
MONTHLY_BUDGET_USD=0
